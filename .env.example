# Copy this file to .env and supply only synthetic local-development values.
# Never commit .env or a provider key.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/banking_demo
JWT_SECRET_KEY=replace-with-a-long-random-local-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# 32-byte url-safe Base64 AES-GCM key. Replace before any shared deploy.
SESSION_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
CHAT_SESSION_TTL_MINUTES=30
API_DOCS_ENABLED=true
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Use one LLM provider. Ollama is the safest default for local synthetic demos.
LLM_PROVIDER=ollama
# Docker Compose deliberately defaults to this separate local-only setting.
# Change it only when you intentionally want container traffic to use a remote provider.
LLM_DOCKER_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1/
# Docker Compose uses this value automatically because 127.0.0.1 inside the
# app container is the container itself, not your computer.
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434/v1/
OLLAMA_MODEL=qwen3:1.7b
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
